datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  profileImage String?
  createdAt    DateTime @default(now())
  posts        Post[]
}

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  image     String?
  createdAt DateTime @default(now())
  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id])
}
